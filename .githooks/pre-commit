#!/bin/bash
# Block staging the mlx-c submodule gitlink; build scripts patch it in-tree.
# lib/mlx-src may be committed only at origin/main's pin (MLX_SERVE_ALLOW_MLX_PIN overrides).
# See docs/gotchas/repo-topology.md and scripts/build-mlx.sh.
set -euo pipefail

while IFS= read -r path; do
  case "$path" in
  lib/mlxc-src)
    echo "PRE-COMMIT BLOCKED: do not stage lib/mlxc-src (dirty mlx-c is intentional; build-mlx.sh patches it)." >&2
    echo "See docs/gotchas/repo-topology.md — never commit inside lib/mlxc-src or its gitlink." >&2
    exit 1
    ;;
  lib/mlx-src)
    if [ -n "${MLX_SERVE_ALLOW_MLX_PIN:-}" ]; then
      continue
    fi
    staged="$(git rev-parse :lib/mlx-src)"
    upstream="$(git rev-parse origin/main:lib/mlx-src 2>/dev/null || true)"
    if [ -z "$upstream" ] || [ "$staged" != "$upstream" ]; then
      echo "PRE-COMMIT BLOCKED: lib/mlx-src pin ${staged} is not origin/main (${upstream:-missing})." >&2
      echo "Set MLX_SERVE_ALLOW_MLX_PIN=1 to override." >&2
      exit 1
    fi
    ;;
  esac
done < <(git diff --cached --name-only)

exit 0
